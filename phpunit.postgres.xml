<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="PostgreSQL Acceptance">
            <directory>tests/Postgres</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="false"/>
        <env name="DB_URL" value="" force="false"/>
        <env name="CACHE_STORE" value="array" force="false"/>
        <env name="SESSION_DRIVER" value="array" force="false"/>
        <env name="QUEUE_CONNECTION" value="sync" force="false"/>
    </php>
</phpunit>
